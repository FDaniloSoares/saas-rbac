{
  "name": "@saas/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_NO_WARNINGS=1 pnpm env:load tsx watch src/http/server.ts",
    "db:migrate": "pnpm env:load prisma migrate dev",
    "db:studio": "pnpm env:load prisma studio",
    "db:seed": "pnpm env:load prisma db seed",
    "db:invites": "pnpm env:load tsx prisma/create-invites.ts",
    "db:pending-invites": "pnpm env:load tsx prisma/create-pending-invites.ts",
    "env:load": "dotenv -e ../../.env --",
    "build": "tsup",
    "start": "node dist/http/server.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@fastify/websocket": "^11.3.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@saas/auth": "workspace:*",
    "@saas/env": "workspace:*",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.6.2",
    "fastify-plugin": "4.5.1",
    "fastify-type-provider-zod": "^6.1.0",
    "pg": "^8.18.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@saas/eslint-config": "workspace:*",
    "@saas/prettier": "workspace:*",
    "@saas/tsconfig": "workspace:*",
    "@types/node": "^24.7.0",
    "@types/pg": "^8.16.0",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6"
  },
  "eslintConfig": {
    "extends": [
      "@saas/eslint-config/node"
    ]
  },
  "prettier": "@saas/prettier"
}
